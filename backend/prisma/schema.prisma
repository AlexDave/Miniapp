datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Пользователь
model User {
  id          Int      @id @default(autoincrement())
  telegram_id String   @unique
  name        String?
  email       String?  @unique
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // telegram_chat_id: личный чат для sendMessage (строка chat.id)
  telegram_chat_id String?
  // Напоминания о тренировке (спринт 20)
  reminders_enabled         Boolean   @default(false)
  reminder_time               String?   // "HH:mm" 24h, напр. "19:00"
  reminder_tz                 String?   // IANA, напр. "Europe/Moscow"
  reminder_quiet_weekends     Boolean   @default(false)
  last_reminder_sent_at       DateTime?
  // Подписка / Stars (спринт 23)
  tier             String    @default("free") // free | pro
  tier_expires_at  DateTime?
  
  // Связи
  profile         Profile?
  payments        Payment[]
  reminderBindTokens ReminderBindToken[]
  userTasks       UserTask[]
  achievements    UserAchievement[]
  notifications   UserNotification[]
  courseProgress  CourseProgress[]
  chatMessages    ChatMessage[]
  dailyReports    DailyReport[]
  lessonProgress  LessonProgress[]
  behaviorEvents  BehaviorEvent[]
  trophyVideos    UserTrophyVideo[]
  analyticsEvents AnalyticsEvent[]
  petMembers      PetMember[]
  petInvitesSent  PetInviteToken[] @relation("PetInviteInviter")

  @@map("users")
}

// Общий виртуальный питомец (семейный режим, спринт 26)
model Pet {
  id                 Int      @id @default(autoincrement())
  name               String   @default("Ваш питомец")
  avatar             String?
  level              Int      @default(1)
  experience         Int      @default(0)
  coins              Int      @default(0)
  skills_json        String?
  bones_json         String?
  total_bones        Int      @default(0)
  special_bones      Int      @default(0)
  stage              String   @default("Знакомство")
  total_courses      Int      @default(0)
  completed_courses  Int      @default(0)
  streak             Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  members      PetMember[]
  profiles     Profile[]
  dailyReports DailyReport[]
  progress     LessonProgress[]
  inviteTokens PetInviteToken[]

  @@map("pets")
}

model PetMember {
  id        Int      @id @default(autoincrement())
  pet_id    Int
  user_id   Int
  role      String   @default("owner") // owner | member
  joined_at DateTime @default(now())

  pet  Pet  @relation(fields: [pet_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([pet_id, user_id])
  @@map("pet_members")
}

model PetInviteToken {
  id               Int      @id @default(autoincrement())
  token            String   @unique
  pet_id           Int
  inviter_user_id  Int
  expires_at       DateTime
  created_at       DateTime @default(now())

  pet     Pet  @relation(fields: [pet_id], references: [id], onDelete: Cascade)
  inviter User @relation("PetInviteInviter", fields: [inviter_user_id], references: [id], onDelete: Cascade)

  @@index([pet_id])
  @@map("pet_invite_tokens")
}

// Одноразовый токен deep-link /start bind_* (лимит start-параметра Telegram)
model ReminderBindToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  user_id    Int
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("reminder_bind_tokens")
}

// Профиль пользователя
model Profile {
  id          Int      @id @default(autoincrement())
  user_id     Int      @unique
  pet_id      Int?
  pet_name    String   @default("Ваш питомец")
  avatar      String?
  level       Int      @default(1)
  experience  Int      @default(0)
  coins       Int      @default(0)
  skills_json String?  // JSON: { "focus": 0-100, "recall": ..., "sit": ... }
  bones_json  String?  // JSON: { "sit": 3, "recall": 1, ... }
  total_bones Int      @default(0)
  special_bones Int    @default(0)
  stage       String   @default("Знакомство")
  total_courses Int    @default(0)
  completed_courses Int @default(0)
  streak      Int      @default(0)
  bio         String?
  preferences String?  // JSON как строка
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  // Связи
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pet         Pet?     @relation(fields: [pet_id], references: [id], onDelete: SetNull)

  @@index([pet_id])
  @@map("profiles")
}

// Курс
model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  video_url   String?
  content     String?
  duration    String?
  rating      Float    @default(0)
  difficulty  String?  @default("Начинающий")
  category    String?
  image       String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Связи
  tasks          Task[]
  courseProgress CourseProgress[]
  modules        Module[]

  @@map("courses")
}

// Модуль курса (1–2 недели контента)
model Module {
  id          Int      @id @default(autoincrement())
  course_id   Int
  title       String
  description String?
  order_index Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@map("modules")
}

// Урок = 1 день практики
model Lesson {
  id          Int      @id @default(autoincrement())
  module_id   Int
  title       String
  description String?
  theory      String?
  order_index Int      @default(0)
  xp_reward   Int      @default(10)
  meta          String?  // JSON: day_id, why, reflection, fallback_tasks, skill, feedback...
  fallback_tree String?  // JSON: L1/L2/L3 упрощения + faq (см. sprint 18)
  is_active     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  module      Module           @relation(fields: [module_id], references: [id], onDelete: Cascade)
  steps       LessonStep[]
  daily_task  DailyTask?
  reports     DailyReport[]
  progress    LessonProgress[]
  trophyVideos UserTrophyVideo[]

  @@map("lessons")
}

// Короткое видео после урока (только владелец; раздача через подписанный URL, спринт 22)
model UserTrophyVideo {
  id                       Int      @id @default(autoincrement())
  user_id                  Int
  lesson_id                Int
  skill_key                String
  storage_key              String   @unique
  mime_type                String
  size_bytes               Int
  atomic_outcome_snapshot  String?
  created_at               DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("user_trophy_videos")
}

// Шаг урока (теоретический контент)
model LessonStep {
  id          Int      @id @default(autoincrement())
  lesson_id   Int
  type        String   // "text" | "diagram" | "card" | "tip" | "image"
  content     String
  image_url   String?  // URL изображения (опционально для любого типа шага)
  image_role  String?  // "hero" | "inline" | "caption"
  alt_text    String?  // alt-текст для изображения
  media_type  String?  // "image" | "gif" | "video" (спринт 19)
  media_url   String?  // URL или путь /lesson-media/... после CDN/статики
  poster_url  String?  // постер для video (fallback при ошибке загрузки)
  order_index Int      @default(0)
  created_at  DateTime @default(now())

  lesson      Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@map("lesson_steps")
}

// Задание дня
model DailyTask {
  id           Int      @id @default(autoincrement())
  lesson_id    Int      @unique
  title        String
  description  String?
  duration_min Int      @default(15)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  lesson       Lesson     @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  steps        TaskStep[]

  @@map("daily_tasks")
}

// Шаг задания (то что пользователь выполняет)
model TaskStep {
  id          Int      @id @default(autoincrement())
  task_id     Int
  type        String   // "checkbox" | "counter" | "rating" | "text"
  label       String
  max_value   Int?
  order_index Int      @default(0)
  created_at  DateTime @default(now())

  task        DailyTask @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("task_steps")
}

// Отчёт пользователя за день
model DailyReport {
  id           Int      @id @default(autoincrement())
  user_id      Int
  pet_id       Int
  lesson_id    Int
  steps_data   String   // JSON: [{step_id, value}]
  rating       Int      @default(2)
  success      String?  // "yes" | "partial" | "no" — итог «получилось?»
  note         String?
  xp_earned    Int      @default(0)
  bones_earned Int      @default(0)
  completed_at DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pet          Pet      @relation(fields: [pet_id], references: [id], onDelete: Cascade)
  lesson       Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([pet_id, lesson_id])
  @@index([user_id, completed_at])
  @@map("daily_reports")
}

// Категория навыков (6 штук: Знакомство, Быт, Социализация, Контроль, Прогулка, Границы, Самостоятельность)
model SkillCategory {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  title       String
  description String?
  icon        String?
  order_index Int     @default(0)

  skills Skill[]

  @@map("skill_categories")
}

// Атомарный под-навык (18 штук)
model Skill {
  id            Int     @id @default(autoincrement())
  key           String  @unique
  category_key  String
  title         String
  description   String?
  unlock_rules  String? // JSON: { requires: { skill_key: min_bones } }
  order_index   Int     @default(0)
  target_bones    Int     @default(5)
  atomic_outcome  String? // микро-результат атома (спринт 22)

  category     SkillCategory @relation(fields: [category_key], references: [key], onDelete: Cascade)
  routeSkills  RouteSkill[]

  @@map("skills")
}

// Прогресс пользователя по уроку (state machine)
model LessonProgress {
  id              Int       @id @default(autoincrement())
  user_id         Int
  pet_id          Int
  lesson_id       Int
  state           String    @default("not_started") // not_started | theory_done | completed
  theory_seen_at  DateTime?
  task_started_at DateTime?
  completed_at    DateTime?
  last_repeat_at  DateTime?
  repeats_count      Int       @default(0)
  attempts_at_level  String?   // JSON: { by_tier: { "1"|"2"|"3": n }, no_total }
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pet    Pet    @relation(fields: [pet_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([pet_id, lesson_id])
  @@index([user_id])
  @@map("lesson_progress")
}

// Задача курса
model Task {
  id             Int      @id @default(autoincrement())
  course_id      Int
  title          String
  description    String?
  required_per_day Int
  available_until DateTime?
  order_index    Int      @default(0)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  
  // Связи
  course         Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  userTasks      UserTask[]
  
  @@map("tasks")
}

// Прогресс пользователя по задаче
model UserTask {
  id              Int      @id @default(autoincrement())
  user_id         Int
  task_id         Int
  completed_today Int      @default(0)
  last_completed_at DateTime?
  progress        Int      @default(0)
  is_completed    Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Связи
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task            Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, task_id])
  @@map("user_tasks")
}

// Персональный маршрут (заменяет треки)
model Route {
  id              Int          @id @default(autoincrement())
  key             String       @unique
  title           String
  description     String?
  icon            String?
  target_problem  String?
  age_min_months  Int?
  age_max_months  Int?
  order_index     Int          @default(0)
  requires_pro    Boolean      @default(false)

  skills RouteSkill[]

  @@map("routes")
}

// Оплата Telegram Stars (XTR), спринт 23
model Payment {
  id                           Int       @id @default(autoincrement())
  user_id                      Int
  payload                      String    @unique
  telegram_payment_charge_id   String?   @unique
  total_amount                 Int
  currency                     String    @default("XTR")
  status                       String    @default("pending")
  plan                         String?
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("payments")
}

// Навык в маршруте (атом skill_key + позиция)
model RouteSkill {
  id          Int    @id @default(autoincrement())
  route_id    Int
  skill_key   String
  order_index Int    @default(0)
  is_required Boolean @default(true)

  route Route @relation(fields: [route_id], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skill_key], references: [key], onDelete: Cascade)

  @@unique([route_id, skill_key])
  @@map("route_skills")
}

// Достижения
model Achievement {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  icon        String?
  color       String?  @default("blue")
  condition   String   // Условия получения достижения (JSON как строка)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  // Связи
  userAchievements UserAchievement[]
  
  @@map("achievements")
}

// Достижения пользователя
model UserAchievement {
  id            Int      @id @default(autoincrement())
  user_id       Int
  achievement_id Int
  earned_at     DateTime @default(now())
  
  // Связи
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, achievement_id])
  @@map("user_achievements")
}

// Уведомления
model Notification {
  id          Int      @id @default(autoincrement())
  title       String
  message     String
  type        String   @default("info") // info, success, warning, error
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())
  
  // Связи
  userNotifications UserNotification[]
  
  @@map("notifications")
}

// Уведомления пользователя
model UserNotification {
  id             Int      @id @default(autoincrement())
  user_id        Int
  notification_id Int
  is_read        Boolean  @default(false)
  read_at        DateTime?
  
  // Связи
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, notification_id])
  @@map("user_notifications")
}

// Прогресс по курсу
model CourseProgress {
  id          Int      @id @default(autoincrement())
  user_id     Int
  course_id   Int
  progress    Int      @default(0) // Процент завершения
  is_completed Boolean @default(false)
  started_at  DateTime @default(now())
  completed_at DateTime?
  last_activity DateTime @default(now())
  
  // Связи
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, course_id])
  @@map("course_progress")
}

// Журнал поведения (инциденты → рекомендации атомов, спринт 21)
model BehaviorEvent {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String   // barking | accident | escape | aggression | chewing | other
  note       String?
  severity   Int      @default(2) // 1–5
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("behavior_events")
}

// Сообщения чата
model ChatMessage {
  id          Int      @id @default(autoincrement())
  user_id     Int
  message     String
  is_bot      Boolean  @default(false)
  created_at  DateTime @default(now())
  
  // Связи
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@map("chat_messages")
}

// События продукта для воронки и retention (спринт 24)
model AnalyticsEvent {
  id      Int      @id @default(autoincrement())
  user_id Int?
  event   String
  props   String?
  ts      DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([event, ts])
  @@index([user_id, ts])
  @@map("analytics_events")
}
