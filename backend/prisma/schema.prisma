datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Пользователь
model User {
  id          Int      @id @default(autoincrement())
  telegram_id String   @unique
  name        String?
  email       String?  @unique
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  // Связи
  profile         Profile?
  userTasks       UserTask[]
  userTracks      UserTrack[]
  achievements    UserAchievement[]
  notifications   UserNotification[]
  courseProgress  CourseProgress[]
  chatMessages    ChatMessage[]
  dailyReports    DailyReport[]
  lessonProgress  LessonProgress[]
  
  @@map("users")
}

// Профиль пользователя
model Profile {
  id          Int      @id @default(autoincrement())
  user_id     Int      @unique
  pet_name    String   @default("Ваш питомец")
  avatar      String?
  level       Int      @default(1)
  experience  Int      @default(0)
  coins       Int      @default(0)
  skills_json String?  // JSON: { "focus": 0-100, "recall": ..., "sit": ... }
  bones_json  String?  // JSON: { "sit": 3, "recall": 1, ... }
  total_bones Int      @default(0)
  special_bones Int    @default(0)
  stage       String   @default("Знакомство")
  total_courses Int    @default(0)
  completed_courses Int @default(0)
  streak      Int      @default(0)
  bio         String?
  preferences String?  // JSON как строка
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  // Связи
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@map("profiles")
}

// Курс
model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  video_url   String?
  content     String?
  duration    String?
  rating      Float    @default(0)
  difficulty  String?  @default("Начинающий")
  category    String?
  image       String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Связи
  tasks          Task[]
  courseProgress CourseProgress[]
  modules        Module[]

  @@map("courses")
}

// Модуль курса (1–2 недели контента)
model Module {
  id          Int      @id @default(autoincrement())
  course_id   Int
  title       String
  description String?
  order_index Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@map("modules")
}

// Урок = 1 день практики
model Lesson {
  id          Int      @id @default(autoincrement())
  module_id   Int
  title       String
  description String?
  theory      String?
  order_index Int      @default(0)
  xp_reward   Int      @default(10)
  meta        String?  // JSON: day_id, why, reflection, fallback_tasks, skill, feedback...
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  module      Module           @relation(fields: [module_id], references: [id], onDelete: Cascade)
  steps       LessonStep[]
  daily_task  DailyTask?
  reports     DailyReport[]
  progress    LessonProgress[]

  @@map("lessons")
}

// Шаг урока (теоретический контент)
model LessonStep {
  id          Int      @id @default(autoincrement())
  lesson_id   Int
  type        String   // "text" | "diagram" | "card" | "tip" | "image"
  content     String
  image_url   String?  // URL изображения (опционально для любого типа шага)
  image_role  String?  // "hero" | "inline" | "caption"
  alt_text    String?  // alt-текст для изображения
  order_index Int      @default(0)
  created_at  DateTime @default(now())

  lesson      Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@map("lesson_steps")
}

// Задание дня
model DailyTask {
  id           Int      @id @default(autoincrement())
  lesson_id    Int      @unique
  title        String
  description  String?
  duration_min Int      @default(15)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  lesson       Lesson     @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  steps        TaskStep[]

  @@map("daily_tasks")
}

// Шаг задания (то что пользователь выполняет)
model TaskStep {
  id          Int      @id @default(autoincrement())
  task_id     Int
  type        String   // "checkbox" | "counter" | "rating" | "text"
  label       String
  max_value   Int?
  order_index Int      @default(0)
  created_at  DateTime @default(now())

  task        DailyTask @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("task_steps")
}

// Отчёт пользователя за день
model DailyReport {
  id           Int      @id @default(autoincrement())
  user_id      Int
  lesson_id    Int
  steps_data   String   // JSON: [{step_id, value}]
  rating       Int      @default(2)
  success      String?  // "yes" | "partial" | "no" — итог «получилось?»
  note         String?
  xp_earned    Int      @default(0)
  bones_earned Int      @default(0)
  completed_at DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson       Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
  @@map("daily_reports")
}

// Категория навыков (6 штук: Знакомство, Быт, Социализация, Контроль, Прогулка, Границы, Самостоятельность)
model SkillCategory {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  title       String
  description String?
  icon        String?
  order_index Int     @default(0)

  skills Skill[]

  @@map("skill_categories")
}

// Атомарный под-навык (18 штук)
model Skill {
  id            Int     @id @default(autoincrement())
  key           String  @unique
  category_key  String
  title         String
  description   String?
  unlock_rules  String? // JSON: { requires: { skill_key: min_bones } }
  order_index   Int     @default(0)
  target_bones  Int     @default(5)

  category     SkillCategory @relation(fields: [category_key], references: [key], onDelete: Cascade)
  routeSkills  RouteSkill[]

  @@map("skills")
}

// Прогресс пользователя по уроку (state machine)
model LessonProgress {
  id              Int       @id @default(autoincrement())
  user_id         Int
  lesson_id       Int
  state           String    @default("not_started") // not_started | theory_done | completed
  theory_seen_at  DateTime?
  task_started_at DateTime?
  completed_at    DateTime?
  last_repeat_at  DateTime?
  repeats_count   Int       @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
  @@map("lesson_progress")
}

// Задача курса
model Task {
  id             Int      @id @default(autoincrement())
  course_id      Int
  title          String
  description    String?
  required_per_day Int
  available_until DateTime?
  order_index    Int      @default(0)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  
  // Связи
  course         Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  userTasks      UserTask[]
  
  @@map("tasks")
}

// Прогресс пользователя по задаче
model UserTask {
  id              Int      @id @default(autoincrement())
  user_id         Int
  task_id         Int
  completed_today Int      @default(0)
  last_completed_at DateTime?
  progress        Int      @default(0)
  is_completed    Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Связи
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task            Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, task_id])
  @@map("user_tasks")
}

// Персональный маршрут (заменяет треки)
model Route {
  id              Int          @id @default(autoincrement())
  key             String       @unique
  title           String
  description     String?
  icon            String?
  target_problem  String?
  age_min_months  Int?
  age_max_months  Int?
  order_index     Int          @default(0)

  skills RouteSkill[]

  @@map("routes")
}

// Навык в маршруте (атом skill_key + позиция)
model RouteSkill {
  id          Int    @id @default(autoincrement())
  route_id    Int
  skill_key   String
  order_index Int    @default(0)
  is_required Boolean @default(true)

  route Route @relation(fields: [route_id], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skill_key], references: [key], onDelete: Cascade)

  @@unique([route_id, skill_key])
  @@map("route_skills")
}

// Трек обучения
model Track {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String?
  difficulty  String?  @default("Начинающий")
  duration_days Int
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  // Связи
  userTracks  UserTrack[]
  
  @@map("tracks")
}

// Прогресс пользователя по треку
model UserTrack {
  id              Int      @id @default(autoincrement())
  user_id         Int
  track_id        Int
  days_remaining  Int
  completed_today Int      @default(0)
  last_completed_at DateTime?
  is_completed    Boolean  @default(false)
  started_at      DateTime @default(now())
  completed_at    DateTime?
  
  // Связи
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  track           Track    @relation(fields: [track_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, track_id])
  @@map("user_tracks")
}

// Достижения
model Achievement {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  icon        String?
  color       String?  @default("blue")
  condition   String   // Условия получения достижения (JSON как строка)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  // Связи
  userAchievements UserAchievement[]
  
  @@map("achievements")
}

// Достижения пользователя
model UserAchievement {
  id            Int      @id @default(autoincrement())
  user_id       Int
  achievement_id Int
  earned_at     DateTime @default(now())
  
  // Связи
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, achievement_id])
  @@map("user_achievements")
}

// Уведомления
model Notification {
  id          Int      @id @default(autoincrement())
  title       String
  message     String
  type        String   @default("info") // info, success, warning, error
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())
  
  // Связи
  userNotifications UserNotification[]
  
  @@map("notifications")
}

// Уведомления пользователя
model UserNotification {
  id             Int      @id @default(autoincrement())
  user_id        Int
  notification_id Int
  is_read        Boolean  @default(false)
  read_at        DateTime?
  
  // Связи
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, notification_id])
  @@map("user_notifications")
}

// Прогресс по курсу
model CourseProgress {
  id          Int      @id @default(autoincrement())
  user_id     Int
  course_id   Int
  progress    Int      @default(0) // Процент завершения
  is_completed Boolean @default(false)
  started_at  DateTime @default(now())
  completed_at DateTime?
  last_activity DateTime @default(now())
  
  // Связи
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, course_id])
  @@map("course_progress")
}

// Сообщения чата
model ChatMessage {
  id          Int      @id @default(autoincrement())
  user_id     Int
  message     String
  is_bot      Boolean  @default(false)
  created_at  DateTime @default(now())
  
  // Связи
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@map("chat_messages")
}
