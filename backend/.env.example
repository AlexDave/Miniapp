# База данных (Prisma/SQLite для разработки)
DATABASE_URL="file:./prisma/dev.db"

# Сервер
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# CORS — URL фронтенда
CORS_ORIGIN=http://localhost:5173

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Dev-режим: фейковый пользователь (используется если нет BOT_TOKEN или initData)
DEV_TELEGRAM_ID=1000000
DEV_USER_NAME=Dev User

# Опционально: GET /api/admin/funnel — заголовок X-Admin-Key
# ADMIN_API_KEY=changeme
