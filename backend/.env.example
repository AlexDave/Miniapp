# База данных (Prisma/SQLite для разработки)
DATABASE_URL="file:./prisma/dev.db"

# Сервер
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# CORS — URL фронтенда
CORS_ORIGIN=http://localhost:5173

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here
# Имя бота без @ — для ссылок привязки напоминаний
TELEGRAM_BOT_USERNAME=your_bot_username
# URL мини-приложения (кнопка web_app в напоминании)
WEB_APP_URL=https://example.com/your-miniapp
# Секрет вебхука (задаётся при setWebhook secret_token) — опционально
# TELEGRAM_WEBHOOK_SECRET=random_long_string

# Dev-режим: фейковый пользователь (используется если нет BOT_TOKEN или initData)
DEV_TELEGRAM_ID=1000000
DEV_USER_NAME=Dev User

# Админ-аналитика: X-Admin-Key или Authorization: Bearer <тот же ключ>
# GET /api/admin/dashboard (HTML), /api/admin/funnel, /api/admin/cohort
# ADMIN_API_KEY=changeme

# Telegram Stars — подписка Pro (спринт 23)
# STARS_PRO_MONTH_AMOUNT=100
# PRO_SUBSCRIPTION_DAYS=30
# TIER_GRACE_DAYS=3
